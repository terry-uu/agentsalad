# Agent Salad environment example
#
# Copy this file to .env only when you need to override defaults.
# Do not commit real API keys, bot tokens, OAuth credentials, or store data.

# Runtime data directory: SQLite DB, workspaces, uploads, file cache.
# Default from source: ./store
# Docker default: /app/store
# AGENTSALAD_STORE_DIR=./store

# Web UI
# The dashboard has no built-in authentication. Keep 127.0.0.1 for local use.
WEB_UI_ENABLED=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=3210

# Timezone
# Internal storage uses UTC. This sets the default display/scheduling timezone
# before it is changed in the Web UI.
# TZ=Asia/Seoul

# Logging
# Common values: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Browser automation
# BROWSER_HEADLESS=false
# BROWSER_CDP_URL=http://127.0.0.1:9222

